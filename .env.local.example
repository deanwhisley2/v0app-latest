# Copy to .env.local. Do not commit `.env.local` or paste keys into the git repo — even
# read-only keys belong in the host’s secret store (Vercel/PM2/Docker env) so history and forks stay clean.

# --- Local-only development (no Supabase / Brevo / exchange calls from API routes) ---
# Set to 1 while building UI on localhost; remove before real staging/production.
# NEXT_PUBLIC_DEV_LOCAL_ONLY=1

# Brevo → SMTP & API → API keys → generate/copy transactional API key (typically starts with xkeysib-)
BREVO_API_KEY=

BREVO_SENDER_EMAIL=noreply@nexuspro.it.com
BREVO_SENDER_NAME=Nexus Pro

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
#
# Deploy smoke (same vars on VPS): curl https://YOUR_DOMAIN/api/health
#   curl https://YOUR_DOMAIN/api/health/supabase  → expects ok:true (Postgres via service role)

# Expert / Joelin POST routes require Supabase auth (session cookie). For curl/CI only, you may set a real
# auth.users id so the server can attribute analyses & sessions (not for public browsers).
# NEXUS_EXPERT_FALLBACK_USER_ID=   # required for scripts/reconcile-on-start.ts & PM2 `start:with-recovery`
# STARTUP_RECOVERY_AUTO_REPAIR=0
# STARTUP_RECOVERY_MAX_AGE_MINUTES=30
# STARTUP_ORCHESTRATE_INSTRUMENTATION=0   # set to 1 to run orchestrateStartupRecovery on Next server boot (fallback if wrapper omitted)
#
# Operational smoke (`npm run operational:smoke`) optional:
# SMOKE_TEST_SYMBOL=BTCUSDT

# Binance (server-only; never NEXT_PUBLIC_*). Used by /api/binance-auth and
# /api/exchange/balance/binance when the client does not send keys.
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=
# Alias for secret (optional): BINANCE_API_SECRET=

# Bitget (server-only; read-only keys recommended). Used by /api/exchange/balance/bitget when the client
# does not send credentials (e.g. server-side polling). Passphrase is the value set when the API key was created.
# BITGET_API_KEY=
# BITGET_API_SECRET=
# Alias: BITGET_SECRET_KEY= or BITGET_API_SECRET_KEY=
# BITGET_PASSPHRASE=

# KuCoin (server-only; for future /api/exchange/balance/kucoin or signed routes — do not guess values).
# Create keys in KuCoin → API Management; passphrase is set when the key is created.
# KUCOIN_API_KEY=
# KUCOIN_API_SECRET=
# KUCOIN_API_PASSPHRASE=
# Optional: 2 (default) = v2 key passphrase header (HMAC); 1 = legacy plain passphrase
# KUCOIN_KEY_VERSION=2

# --- Joelin in-app guide (DeepSeek primary; server-only key) ---
# When set, POST /api/nexus-assistant answers as Joelin via DeepSeek (OpenAI-compatible API), using a local factual anchor.
# Leave unset to use the local anchor text only (no external calls).
# DEEPSEEK_API_KEY=
# Optional: default https://api.deepseek.com/v1
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# Optional: default deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# --- Time-bound analysis / Grok (xAI; server-only) ---
# Used by POST /api/analysis/time-bound when includeGrok is true.
# Prefers POST https://api.x.ai/v1/responses (store:false); set XAI_API_STYLE=chat for legacy chat/completions only.
# Pipeline live only when ALL three: subscription active + operator enable + key (see lib/grok-pipeline-status.ts).
# XAI_API_KEY=
# XAI_MODEL=grok-4.3
# XAI_API_STYLE=auto
# Billing / credits gate — leave unset or 0 until xAI subscription is active (no API spend). GET /api/grok/status
# NEXUS_GROK_SUBSCRIPTION_ACTIVE=0
# Set to 1 to arm Grok in analysis after subscription is active (still requires XAI_API_KEY).
# NEXUS_GROK_ENABLED=0
# Which symbols may consume live Grok quota: focus | focus_plus_trader | all (see lib/grok-symbol-eligibility.ts).
# focus_plus_trader = focus universe ∪ bases from AUTO_TRADER_SYMBOLS (good for auto-trader + dashboard).
# NEXUS_GROK_QUOTA_SCOPE=focus_plus_trader

# FAST-mode analysis execution TTL (seconds); clamped 30–45; default 45 if unset.
# NEXUS_FAST_ANALYSIS_TTL_SECONDS=45

# --- Real Binance spot (server-only; DANGER) ---
# NEXUS_REAL_TRADING=1          # required for live executeOrder + /api/trade/execute
# NEXUS_REAL_TRADE_SECRET=...    # YOU invent this (not from Binance). Same string in curl header x-nexus-real-trade-secret
#                                Generate one: npm run trade-secret:gen
# BINANCE_API_KEY=              # server-side signing (terminal /api/trade/* uses these, not browser keys)
# BINANCE_SECRET_KEY=
# Optional: comma-separated USDT spot pairs allowed when NEXUS_REAL_TRADING=1 (default BTCUSDT,ETHUSDT)
# NEXUS_REAL_TRADE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# NEXUS_TRADE_PORTFOLIO_USD=20   # sizing reference (default 20)
# PROCESS_TRADE_SECRET=...       # optional: POST /api/trades/record for ledger

# --- scripts/auto-trader-daemon.ts (PM2: nexus-auto-trader) ---
# Same machine as Next: point at your app origin (no trailing slash).
# AUTO_TRADER_API_BASE=http://localhost:3000
# AUTO_TRADER_ENABLED=true
# AUTO_TRADER_SYMBOLS=BTC,ETH
# AUTO_TRADER_POSITION_SIZE_USD=5
# AUTO_TRADER_POSITION_SIZE_MAX_USD=10
# AUTO_TRADER_MAX_POSITIONS=2
# AUTO_TRADER_MAX_EXPOSURE_USD=20
# AUTO_TRADER_DAILY_LOSS_LIMIT_USD=4
# AUTO_TRADER_STOP_LOSS_PERCENT=2
# AUTO_TRADER_TAKE_PROFIT_PERCENT=4
# AUTO_TRADER_CONFIDENCE_MIN=65
# AUTO_TRADER_ANALYSIS_INTERVAL_MS=300000
# AUTO_TRADER_MONITOR_INTERVAL_MS=30000
# Minimum analysis window: default 300s (same floor as /api/expert/analyze). Dev-only: AUTO_TRADER_RELAX_TIME_WINDOW=1 allows 60s floor.
# AUTO_TRADER_RELAX_TIME_WINDOW=
# AUTO_TRADER_TIME_WINDOW_SECONDS=300
# AUTO_TRADER_POSITION_MAX_MS=7200000
# Daemon Grok: unset → signed forceGrok on POST /api/analysis/time-bound (uses NEXUS_REAL_TRADE_SECRET). Saves quota when 0.
# AUTO_TRADER_FORCE_GROK=0
# Open-position combat (default on): periodic fused analysis while LONG + optional TP defer when still bullish. Disable with 0.
# AUTO_TRADER_POSITION_COMBAT=0
# AUTO_TRADER_COMBAT_ANALYSIS_MS=240000
# AUTO_TRADER_COMBAT_TIME_WINDOW_SECONDS=180
# AUTO_TRADER_COMBAT_EXIT_CONFIDENCE=72
# AUTO_TRADER_COMBAT_HOLD_TP_CONFIDENCE=68
# AUTO_TRADER_COMBAT_MAX_TP_DEFERS=5

# --- scripts/observation-window.ts (observational learning; no live orders) ---
# Requires NEXUS_EXPERT_FALLBACK_USER_ID (same as reconcile). PM2: `npx pm2 start ecosystem.config.js --only nexus-observation-window`
# OBSERVATION_SYMBOLS=BTCUSDT,ETHUSDT
# OBSERVATION_INTERVAL_MS=180000
# OBSERVATION_ANALYSIS_WINDOW_SECONDS=60
# OBSERVATION_GOVERNANCE_PROBE_USD=5
# OBSERVATION_UNTIL=2026-05-07T23:59:59.000Z
# OBSERVATION_SKIP_STABILITY=0

# Optional: set to 1 to turn OFF “continue without email/password” (guest) login
# NEXT_PUBLIC_DISABLE_GUEST=1

# Dev only: comma-separated hosts you type in the browser (fixes blank page / “Unauthorized” on /_next when
# not using localhost). Example: LAN IP shown by `next dev` under “Network”, or 127.0.0.1 if you use that URL.
# NEXT_PUBLIC_DEV_EXTRA_ORIGINS=127.0.0.1,192.168.1.10

# When 1, dashboard “real trade ready” UI (Wall Street / A/B modes) does not require a browser-linked exchange if you
# only trade via terminal with server BINANCE_* keys (guest-friendly for testing).
# NEXT_PUBLIC_ALLOW_SERVER_SIDE_EXECUTION_UI=1
