# Copy to .env.local. Do not commit `.env.local` or paste keys into the git repo — even
# read-only keys belong in the host’s secret store (PM2/Docker/systemd env) so history and forks stay clean.

# --- Local-only development (no Supabase / Brevo / exchange calls from API routes) ---
# Set to 1 while building UI on localhost; remove before real staging/production.
# NEXT_PUBLIC_DEV_LOCAL_ONLY=1

# Brevo → SMTP & API → API keys → generate/copy transactional API key (typically starts with xkeysib-)
BREVO_API_KEY=

BREVO_SENDER_EMAIL=noreply@nexuspro.it.com
BREVO_SENDER_NAME=Nexus Pro

# Public site URL (metadata, auth redirects, recovery links). Production: https://nexuspro.it.com
NEXT_PUBLIC_SITE_URL=https://nexuspro.it.com

# --- Cloudflare Turnstile (registration CAPTCHA; server-verified at POST /api/auth/register) ---
# Dashboard: https://dash.cloudflare.com/ → Turnstile → Add site (widget mode: Managed).
# Production VPS/PM2: set BOTH. Omit in local dev to skip verification (NODE_ENV !== production).
# Test keys (always pass): https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
#
# Deploy smoke (same vars on VPS):
#   curl -sS https://YOUR_DOMAIN/api/health
#   curl -sS https://YOUR_DOMAIN/api/health/supabase   → ok:true when Postgres reachable (service role)
#   curl -sS https://YOUR_DOMAIN/api/health/launch     → ok:true when URL + anon + service role + DB ping pass; tier matrix JSON; optional_services (Brevo, NEXT_PUBLIC_SITE_URL)
# After local start: LAUNCH_URL=http://127.0.0.1:3000 npm run verify:launch

# --- Canonical user tiers (SSOT: Supabase public.profiles; seed with docs/supabase-delta-canonical-user-levels.sql) ---
# Example mapping: deanwhisley2 @ any domain → Level 5; esknexuspro → Level 2 + retailer_credit_seller.
# API admin fallback when JWT profile is ambiguous (comma-separated IDs or lowercase emails):
# NEXUS_ADMIN_USER_IDS=
# NEXUS_ADMIN_EMAILS=

# --- Treasury settlement when Level 5 approves retailer float (crypto) top-ups ---
# Amount credited to retailer Retail Balance = amount_requested × (1 + commission_rate), usually +5% commission.
# The SAME credited total is debited from treasury Nexus Main — traceable one-to-one settlement.
#
# OPTION A (recommended): dedicated operational pool user — fund its Nexus Main (available_balance).
# Must be the auth profile UUID (public.profiles.id), NOT the referral short code. Resolve with:
#   SELECT id FROM public.profiles WHERE upper(trim(referral_code)) = 'YOUR_REFERRAL';
# Example ops referral NX1TB8NK95 → pool UUID from DB (production/staging differ).
# NEXUS_ADMIN_RETAIL_POOL_USER_ID=
#
# OPTION B: no pool — explicitly debit the approving Level-5 operator’s Nexus Main each time:
# NEXUS_FLOAT_DEBIT_USE_APPROVER_WITHOUT_POOL=1
#
# Optional: reject approvals unless A or B is configured (blocks silent "none" credits):
# NEXUS_MASTER_LIQUIDITY_STRICT=1
#
# Dashboard → Operations → Approval shows active mode, pool balance, aggregates (requires DB fn admin_treasury_float_stats).
#
# --- Level-2 retailer credit sellers (optional; max five accounts) ---
# Prefer Supabase: profiles.retailer_credit_seller = true (see docs/supabase-delta-retailer-credit-seller.sql).
# Comma-separated UUIDs and/or emails mirror the same allowlist without a DB migration:
# NEXUS_RETAILER_CREDIT_SELLER_IDS=
# NEXUS_RETAILER_CREDIT_SELLER_EMAILS=

# Company crypto receive (shown under Dashboard → Add Funds → Option A; no secrets, public address OK)
# NEXUS_COMPANY_CRYPTO_WALLET=
# NEXUS_COMPANY_CRYPTO_NETWORK=USDT TRC20

# Expert / Joelin POST routes require Supabase auth (session cookie). For curl/CI only, you may set a real
# auth.users id so the server can attribute analyses & sessions (not for public browsers).
# NEXUS_EXPERT_FALLBACK_USER_ID=   # required for scripts/reconcile-on-start.ts & PM2 `start:with-recovery`
# STARTUP_RECOVERY_AUTO_REPAIR=0
# STARTUP_RECOVERY_MAX_AGE_MINUTES=30
# STARTUP_ORCHESTRATE_INSTRUMENTATION=0   # set to 1 to run orchestrateStartupRecovery on Next server boot (fallback if wrapper omitted)

# --- CompreFace (serious selfie verification; optional but recommended) ---
# COMPRE_FACE_API_URL=http://127.0.0.1:8000
# COMPRE_FACE_API_KEY=
# COMPRE_FACE_VERIFY_THRESHOLD=0.82
#
# Operational smoke (`npm run operational:smoke`) optional:
# SMOKE_TEST_SYMBOL=BTCUSDT

# Binance (server-only; never NEXT_PUBLIC_*). Used by /api/binance-auth and
# /api/exchange/balance/binance when the client does not send keys.
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=
# Alias for secret (optional): BINANCE_API_SECRET=

# Bitget (server-only; read-only keys recommended). Used by /api/exchange/balance/bitget when the client
# does not send credentials (e.g. server-side polling). Passphrase is the value set when the API key was created.
# BITGET_API_KEY=
# BITGET_API_SECRET=
# Alias: BITGET_SECRET_KEY= or BITGET_API_SECRET_KEY=
# BITGET_PASSPHRASE=

# KuCoin (server-only; for future /api/exchange/balance/kucoin or signed routes — do not guess values).
# Create keys in KuCoin → API Management; passphrase is set when the key is created.
# KUCOIN_API_KEY=
# KUCOIN_API_SECRET=
# KUCOIN_API_PASSPHRASE=
# Optional: 2 (default) = v2 key passphrase header (HMAC); 1 = legacy plain passphrase
# KUCOIN_KEY_VERSION=2

# --- Joelin in-app guide (DeepSeek primary; server-only key) ---
# When set, POST /api/nexus-assistant answers as Joelin via DeepSeek (OpenAI-compatible API), using a local factual anchor.
# Leave unset to use the local anchor text only (no external calls).
# DEEPSEEK_API_KEY=
# Optional: default https://api.deepseek.com/v1
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# Optional: default deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# --- Time-bound analysis / Grok (xAI; server-only) ---
# Used by POST /api/analysis/time-bound when includeGrok is true.
# Prefers POST https://api.x.ai/v1/responses (store:false); set XAI_API_STYLE=chat for legacy chat/completions only.
# Pipeline live only when ALL three: subscription active + operator enable + key (see lib/grok-pipeline-status.ts).
# XAI_API_KEY=
# XAI_MODEL=grok-4.3
# XAI_API_STYLE=auto
# Billing / credits gate — leave unset or 0 until xAI subscription is active (no API spend). GET /api/grok/status
# NEXUS_GROK_SUBSCRIPTION_ACTIVE=0
# Set to 1 to arm Grok in analysis after subscription is active (still requires XAI_API_KEY).
# NEXUS_GROK_ENABLED=0
# Which symbols may consume live Grok quota: focus | focus_plus_trader | all (see lib/grok-symbol-eligibility.ts).
# focus_plus_trader = focus universe ∪ bases from AUTO_TRADER_SYMBOLS (optional bonus list for quota).
# NEXUS_GROK_QUOTA_SCOPE=focus_plus_trader

# FAST-mode analysis execution TTL (seconds); clamped 30–45; default 45 if unset.
# NEXUS_FAST_ANALYSIS_TTL_SECONDS=45

# --- Real Binance spot (server-only; DANGER) — legacy terminal execute paths removed from this tree ---
# NEXUS_REAL_TRADING=1
# NEXUS_REAL_TRADE_SECRET=...    # Trusted same-machine callers: header x-nexus-real-trade-secret. npm run trade-secret:gen
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=
# NEXUS_REAL_TRADE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# NEXUS_TRADE_PORTFOLIO_USD=20
# PROCESS_TRADE_SECRET=...       # optional: POST /api/trades/record for ledger

# Optional: comma-separated bases (e.g. BTC,ETH) merged into Grok quota when NEXUS_GROK_QUOTA_SCOPE=focus_plus_trader
# AUTO_TRADER_SYMBOLS=BTC,ETH

# Optional: set to 1 to turn OFF “continue without email/password” (guest) login
# NEXT_PUBLIC_DISABLE_GUEST=1

# Dev only: comma-separated hosts you type in the browser (fixes blank page / “Unauthorized” on /_next when
# not using localhost). Example: LAN IP shown by `next dev` under “Network”, or 127.0.0.1 if you use that URL.
# NEXT_PUBLIC_DEV_EXTRA_ORIGINS=127.0.0.1,192.168.1.10

# When 1, dashboard “real trade ready” UI (Wall Street / A/B modes) does not require a browser-linked exchange if you
# only trade via terminal with server BINANCE_* keys (guest-friendly for testing).
# NEXT_PUBLIC_ALLOW_SERVER_SIDE_EXECUTION_UI=1
